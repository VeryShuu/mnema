# Mnema — .env.example
# Avtogeneraciya iz mnema/core/registry.py (FT-37/FT-38).
# Klassy: [R] required-explicit, [D] defaulted, [C:*] capability.
# Pustom znacheniyu = klyuch ne zadan; povedenie v kommente.

# --- core (api/worker/web-bot) -----------------------------------
# [D=sqlite:////data/db.sqlite] chitaet: api/worker; nuzhen: vsegda; esli pusto: SQLite na /data (6.4); postgres pri roste
#   SQLite na starte; postgres: ...postgresql://...
DATABASE_URL=sqlite:////data/db.sqlite
# [D=redis://redis:6379/0] chitaet: api/worker/web-bot; nuzhen: vsegda; esli pusto: redis:6379 po umolchaniyu
REDIS_URL=redis://redis:6379/0
# [D=http://localhost:8000] chitaet: notifier/api; nuzhen: ssylki v pishmah (FT-35b); esli pusto: http://localhost:8000
MNEMA_PUBLIC_URL=http://localhost:8000
# [D=Europe/Moscow] chitaet: api/worker/web-bot (UI, uvedomleniya, cron); nuzhen: otobrazenie i vzor daty (FT-22); esli pusto: Europe/Moscow
#   poyas veb-interfeysa i pisen; hranenie vsegda UTC
APP_TZ=Europe/Moscow
# [D=puto] chitaet: api (REST-klienty: portal); nuzhen: auth upravlencheskih /api/jobs* (zagolovok X-API-Key); esli pusto: bez auth — tol'ko setevoy perimetr
#   vnutrennie endpointy web-bot i veb-UI ne ohvacheni
API_TOKEN=

# --- recorder (web-bot chitaet vsyo) -----------------------------
# [R] chitaet: web-bot; nuzhen: vsegda; esli pusto: => web-bot ne startuet
ZOOM_PROFILE_DIR=
# [D=Mnema] chitaet: web-bot; nuzhen: pre-join; esli pusto: Mnema
BOT_NAME=Mnema
# [D=https://app.zoom.us/wc/{meeting_id}/join?pwd={pwd}] chitaet: web-bot; nuzhen: start sessii; esli pusto: shablon po FT-1
RECORDER_URL_TEMPLATE=https://app.zoom.us/wc/{meeting_id}/join?pwd={pwd}
# [D=120] chitaet: scheduler; nuzhen: planovye vstrechi; esli pusto: 2 min do start_at
BOT_PREJOIN_SECONDS=120
# [D=10] chitaet: web-bot; nuzhen: FT-5; esli pusto: 10 min
JOIN_DEADLINE_MIN=10
# [D=5] chitaet: web-bot; nuzhen: FT-4; esli pusto: 5 min
SILENCE_END_TIMEOUT_MIN=5
# [D=30] chitaet: web-bot; nuzhen: avovyhod po tişine; esli pusto: 30 min
#   posle vklyucheniya zapisi zhdyom eto vremya; RMS nizhe SILENCE_LEVEL_DB >= SILENCE_END_TIMEOUT_MIN nepreryvno -> vyvod iz konferentsii (Leave + podtverzhdeniye)
SILENCE_GRACE_MIN=30
# [D=-50] chitaet: web-bot; nuzhen: porog zvuka v dBFS dlya detektora tişiny; esli pusto: -50
#   otzyv vyshe poroga sbrasyvaet taymer; comfort-noise Zoom ~ -60..-70 dBFS, shëpot ~ -45
SILENCE_LEVEL_DB=-50
# [D=360] chitaet: web-bot; nuzhen: FT-4; esli pusto: 6 ch
BOT_MAX_DURATION_MIN=360
# [D=2] chitaet: web-bot; nuzhen: FT-4; esli pusto: 2
PAGE_RELOAD_RETRIES=2
# [D=15] chitaet: web-bot; nuzhen: reCAPTCHA na Join (§12); esli pusto: 15 min zhdёm vruchnuyu prokhoda cherez noVNC
CAPTCHA_WAIT_MIN=15
# [D=20] chitaet: web-bot/api; nuzhen: individual'nyye ekrany VNC vstrech; esli pusto: 20 slotov (porty 6081-6100 / 8081-8100)
#   setup-ekran vsegda slot 0 (6080 / 8080)
VNC_MAX_SLOTS=20
# [D=8080] chitaet: api/web-bot; nuzhen: ssylki noVNC v UI i pishmah; esli pusto: 8080+slot
VNC_PUBLIC_PORT_BASE=8080
# [D=1440x900x24] chitaet: web-bot; nuzhen: razresheniye Xvfb-ekranov; esli pusto: 1440x900x24
VNC_SCREEN=1440x900x24
# [D=puto] chitaet: web-bot; nuzhen: parol' VNC-protokola (rfbauth) dlya ecranov; esli pusto: bez parolya (rfb zakryt -localhost, dostup cherez websockify)
#   rekomen. pri publikatsii 8080-8100 na nedoverennuyu set'
VNC_PASSWORD=
# [D=puto] chitaet: web-bot; nuzhen: bind-adres websockify vnutri konteynera; esli pusto: vse interfeysy (0.0.0.0)
#   Smezhno s VNC_PUBLISH_BIND v docker-compose (publikatsiya na hoste)
VNC_BIND_ADDR=
# [D=12] chitaet: scheduler; nuzhen: FT-24; esli pusto: 12
RELOGIN_DUE_DAYS=12
# [D=0 9 * * *] chitaet: scheduler; nuzhen: FT-24; esli pusto: 09:00 ezhednevno
SESSION_HEALTHCRON=0 9 * * *
# [D=puto] chitaet: scheduler; nuzhen: ne zapuskat' po raskhaniyu; esli pusto: net DND
DND_CRON=
# [D=1] chitaet: web-bot; nuzhen: anons pri vhode v sozvon (FT-10); esli pusto: vklyuchen
#   0/false/off/no -> anons propuskaetsya; faila net -> bez anonsa
ANNOUNCE_ENABLED=1
# [D=templates/announce.wav] chitaet: web-bot; nuzhen: FT-10; esli pusto: templates/announce.wav; net faila -> bez ob'yavleniya
ANNOUNCE_WAV=templates/announce.wav
# [D=/data/web-bot.heartbeat] chitaet: web-bot/api; nuzhen: diagnostika watchdog-a (v detailyah sobytiya); esli pusto: /data/web-bot.heartbeat (obshchiy volume)
#   molotok zhivost'i web-bot, piletsya kazhdye 15 s
WEBBOT_HEARTBEAT_FILE=/data/web-bot.heartbeat
# [D=20] chitaet: api (maintenance_job); nuzhen: watchdog recording; esli pusto: 20 min
#   net eventov dolshe — v salvage-ochered' (syryye segmenty -> final'nye fayly, POST finished)
STALLED_RECORDING_MIN=20
# [D=100] chitaet: web-bot; nuzhen: disk-gard pri zapisi chankov; esli pusto: 100 MB
#   padezh/IO oshibka -> alert + chanki ostayutsya v pamyati stranicy do osvobozhdeniya
MIN_FREE_DISK_MB=100

# --- notify (obyazatel'en; sboy bez pisma = defekt, FT-24) -------
# [R] chitaet: notifier; nuzhen: vsegda; esli pusto: => servis ne startuet
SMTP_HOST=
# [D=587] chitaet: notifier; nuzhen: vsegda; esli pusto: 587 STARTTLS
SMTP_PORT=587
# [D=puto] chitaet: notifier; nuzhen: relay s avtorizaciey; esli pusto: bez avtorizacii
SMTP_USER=
# [D=puto] chitaet: notifier; nuzhen: relay s avtorizaciey; esli pusto: bez parolya
#   ssylka na vault: //secret-store (FT-38), ne parol'
SMTP_PASSWORD_REF=
# [D=puto] chitaet: notifier; nuzhen: esli SMTP_PASSWORD_REF pust i relay trebuet; esli pusto: bez parolya
SMTP_PASSWORD=
# [R] chitaet: notifier; nuzhen: vsegda; esli pusto: => servis ne startuet
NOTIFY_EMAIL_TO=
# [D=puto] chitaet: notifier; nuzhen: FT-35g; esli pusto: bez kopii
NOTIFY_EMAIL_ADMIN=
# [D=Mnema <mnema@localhost>] chitaet: notifier; nuzhen: vsegda; esli pusto: Mnema <mnema@localhost>
NOTIFY_FROM=Mnema <mnema@localhost>
# [D=60] chitaet: notifier; nuzhen: FT-35v; esli pusto: 60 min
ALERT_COOLDOWN_MIN=60
# [D=0 9 * * *] chitaet: scheduler; nuzhen: FT-35v; esli pusto: 09:00
ALERT_DIGEST_CRON=0 9 * * *
# [D=job_failed=email,session_relogin_due=email,protocol_ready=email,awaiting_llm=email,job_export_failed=email,confirm_end=email,alert=email] chitaet: notifier; nuzhen: FT-36; v kljade otkaza vygruzki v sampu; alert — pisma ot web-bot (/api/alert: reCAPTCHA, зависший вход); esli pusto: defolt iz FT-36 + job_export_failed, confirm_end, alert
NOTIFY_EVENTS=job_failed=email,session_relogin_due=email,protocol_ready=email,awaiting_llm=email,job_export_failed=email,confirm_end=email,alert=email

# --- asr (capability:asr; worker kak klient) ---------------------
# [D=gigastt] chitaet: worker:asr; nuzhen: FT-12; esli pusto: gigastt | faster-whisper
ASR_ENGINE=gigastt
# [C:asr] chitaet: worker:asr; nuzhen: FT-12/FT-39; esli pusto: => asr=not_configured, fallback faster-whisper
ASR_BASE_URL=http://ai-host:9876
# [C:asr] chitaet: worker:asr; nuzhen: gigastt s API_TOKEN; esli pusto: bez auth
ASR_API_KEY=
# [C:asr] chitaet: worker:asr; nuzhen: vybor modeli gigastt; esli pusto: ml_ctc_large
ASR_MODEL=ml_ctc_large
# [D=1024] chitaet: worker:asr; nuzhen: gigastt >=2.21 (GIGASTT_BODY_LIMIT_BYTES=1 GiB); esli pusto: 40 MB (chunkovanie)
ASR_MAX_UPLOAD_MB=1024
# [D=cpu] chitaet: worker; nuzhen: fallback-whisper i embeddingy; esli pusto: cpu | cuda:0
ASR_DEVICE=cpu
# [D=puto] chitaet: worker:asr; nuzhen: GPU-versiya (float16 ~x2 bystree); esli pusto: float16 na cuda, int8 na cpu
WHISPER_COMPUTE_TYPE=
# [D=1] chitaet: worker:asr; nuzhen: GPU-versiya: half precision diarizatsiya; esli pusto: 0 vypernut' fp32
DIAR_FP16=1
# [D=32] chitaet: worker:asr; nuzhen: GPU-versiya: segmentation/embedding batch; esli pusto: 32 (na CPU umenshit' do 4)
DIAR_BATCH_SIZE=32
# [D=pyannote-3.1] chitaet: worker:asr; nuzhen: FT-25; esli pusto: pyannote-3.1
DIARIZER=pyannote-3.1
# [D=0] chitaet: worker:speaker; nuzhen: chuvstvitel'nost' k korotkim smenam golosa; esli pusto: defolt pyannote (1.0 s)
#   shag slizheniya segmentation v s; 0 < DIAR_SEG_STEP < 10 (dlinna okna); men'she — tochnye granicy, dorzhe raschet
DIAR_SEG_STEP=0
# [C:asr] chitaet: worker:asr,worker:speaker; nuzhen: FT-25/FT-27; esli pusto: pyannote gated wies nie dotupy: diari/embieddingi stub
HF_TOKEN=
# [D=0.65] chitaet: worker:speaker; nuzhen: FT-27; esli pusto: 0.65 (kalibrovat'!)
SPEAKER_T_CONFIRM=0.65
# [D=0.45] chitaet: worker:speaker; nuzhen: FT-27; esli pusto: 0.45
SPEAKER_T_HINT=0.45
# [D=1.5] chitaet: worker:speaker; nuzhen: minimal'naya dlitel'nost' fragmenta dlya embeddinga klastera; esli pusto: 1.5 s
EMBED_MIN_S=1.5
# [D=1] chitaet: worker:speaker; nuzhen: frazy, zvuchashchie ne kak govoryashchiy klastera, perenodyatsya v drugoy/podklaster; esli pusto: vklyucheno (0 = vykl)
PHRASE_VERIFY=1
# [D=1.0] chitaet: worker:speaker; nuzhen: frazy korotshe ne proveryayutsya (emgedding nadezhnet ot shuma); esli pusto: 1.0 s
PHRASE_VERIFY_MIN_S=1.0
# [D=0.30] chitaet: worker:speaker; nuzhen: cos s centrodom klastera, pri ktorom fraza ostaetsya v njem; esli pusto: 0.30
PHRASE_KEEP_COS=0.30
# [D=0.45] chitaet: worker:speaker; nuzhen: min cos s chuzhim centrodom dlya perenosa frazy v nego; esli pusto: 0.45
PHRASE_MATCH_COS=0.45
# [D=48] chitaet: worker:speaker; nuzhen: FT-28; esli pusto: 48 ch
REVIEW_TIMEOUT_HOURS=48

# --- llm (capability:llm; strukturirovanie protokola) ------------
# [C:llm] chitaet: worker:structure; nuzhen: FT-40; esli pusto: => llm=not_configured, Job v awaiting_llm
LLM_BASE_URL=http://ai-host:11434/v1
# [C:llm] chitaet: worker:structure; nuzhen: ne-Ollama brendy; esli pusto: pusto dlya Ollama
LLM_API_KEY=
# [C:llm] chitaet: worker:structure; nuzhen: FT-17; esli pusto: llama3-saiga:32b
LLM_MODEL=llama3-saiga:32b
# [D=puto] chitaet: worker:structure; nuzhen: operatorskiy geyt; esli pusto: razresheny vse modeli
LLM_MODEL_ALLOWLIST=
# [D=off] chitaet: worker:structure; nuzhen: razmyshleniya modeli (rezhim mysley); esli pusto: off (minimum razmyshleniy: think=false)
#   on = razreshit' glubokie razmyshleniya modeley (medlennee; esli server ne znaet flag think — on avtomaticheski otmershaetsya i bolshe ne peredaetsya)
LLM_THINKING=off
# [D=24000] chitaet: worker:structure; nuzhen: okno stenogrammy na 1 zaprosov LLM; esli pusto: 24000 simptomovol; svyyshe — map-reduce po oknam
#   v docker-compose zadano 60000 (context 131k, predpochtit' odin zaprosov neskol'kim posledovatel'nykh)
LLM_WINDOW_CHARS=24000
# [D=900] chitaet: worker:structure; nuzhen: taymaut 1 HTTP-zaprosov k LLM; esli pusto: 900 s (vsegda >= 30)
#   podnyat s 600: bol'shaya stenogramma na medlennoy modeli generiruet protokoly shtatno >10 min
LLM_REQUEST_TIMEOUT_S=900
# [D=16000] chitaet: worker:structure; nuzhen: potolok generacii protokola; esli pusto: 16000; 0 — bez polya max_tokens
#   razvyornyy protokol (svodki po temam so vsemi tsiframi, blok changes) ne pomeshaetsya v 6-8k tokenov; bez polya model' vykladyvaet shtop-potolok i zapros vykhodit za taymaut
LLM_MAX_TOKENS=16000
# [D=3600] chitaet: worker:structure; nuzhen: ozhidanie svoy ocheredi k LLM; esli pusto: 3600 s; svyyshe — LLMError (awaiting_llm / split_skipped)
#   v docker-compose zadano 7200 (ochered' na odin LLM)
LLM_LOCK_WAIT_TIMEOUT_S=3600
# [D=720] chitaet: worker:structure; nuzhen: arenda LLM-tokena (redis zamyok); esli pusto: vsegda >= LLM_REQUEST_TIMEOUT_S+60; umershiy process otpustit ne dolshe
#   odnovremenno k LLM — rovno odin zaprosov (FIFO-ochered')
LLM_LOCK_LEASE_S=720

# --- storage -----------------------------------------------------
# [R] chitaet: archiver/api; nuzhen: vsegda; esli pusto: => servis ne startuet
ARCHIVE_DIR=
# [D=180] chitaet: scheduler; nuzhen: HT-3; esli pusto: 180
RETENTION_DAYS=180
# [D=8] chitaet: api; nuzhen: zagruzka arhivnyh zapisey; esli pusto: 8 GB na fayl
UPLOAD_MAX_GB=8
# [D=16] chitaet: api; nuzhen: chunk pri zagruzke arhiva; esli pusto: 16 MB
UPLOAD_CHUNK_MB=16
# [D=1] chitaet: worker; nuzhen: posle izvlecheniya audio iz arhiva; esli pusto: hranit' ishodnik (0 = udalyat' posle konversii)
KEEP_UPLOADED_SOURCE=1
# [D=puto] chitaet: api/worker; nuzhen: vygruzka v samba-zerkalo (/export); esli pusto: vyvodka vyklyuchena (no-op)
EXPORT_DIR=
# [D=puto] chitaet: docker-compose; nuzhen: hostovyy CIFS-maunt dlya /export; esli pusto: maunt neaktivny (skript scripts/smb-mount.sh)
EXPORT_HOST_DIR=

# --- stenogramma: koalescencia -----------------------------------
# [D=20] chitaet: api/worker; nuzhen: sliyanie sosednih reperok odnogo govoryashchego; esli pusto: 20 s
#   pri vyvode (pustye reperiki vykidyvayutsya vsegda)
COALESCE_MAX_GAP_S=20
# [D=1] chitaet: api/worker; nuzhen: razbienie VAD-stroki s dvumya golosami; esli pusto: vkl (0 = vyklyuchit' razrez po turns)
#   stroka s dvumya govorashchimi delaetsya na otdel'nyye replitu po granitsam diar turns i timeshampam ASR-chastey
COALESCE_SPLIT_TURNS=1
# [D=0.35] chitaet: api/worker; nuzhen: porog otdeleniya ASR-chasti s chuzhim golosom; esli pusto: 0.35
#   dolya pokrytiya chuzhim turn-om pri kotoroy chast' otdelyaetsya ot stroki (nizhe — mel'koe nakhozhenie ne rezhetsya)
COALESCE_PART_MIN_COVERAGE=0.35
