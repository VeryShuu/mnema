FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg mkvtoolnix \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-asr.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY mnema ./mnema
COPY alembic.ini alembic/ ./
# Tyazhelye ASR-diaperizatsii zavisimosti (torch/pyannote/faster-whisper)
# USTANAVLIVAYUTSYA PO TREBOVANIYU: docker build --build-arg WITH_ASR=1
ARG WITH_ASR=0
RUN if [ "$WITH_ASR" = "1" ]; then pip install --no-cache-dir -r requirements-asr.txt; fi

EXPOSE 8000
CMD ["python", "-m", "mnema.api.main"]
